# ===== 動作モード =====
# true の間は媒体への入稿・停止・予算変更を一切しない（既定 true）
ADOPS_DRY_RUN=true

# ===== Claude（企画・レビュー・画像審査・分析） =====
ANTHROPIC_API_KEY=
# ADOPS_MODEL=claude-opus-5-5        # 企画・分析
# ADOPS_FAST_MODEL=claude-sonnet-5-5 # レビュー・画像審査
# ADOPS_EFFORT=high

# ===== 画像生成 =====
# handoff: 人が midjourney.com で生成して data/inbox/<ID>/ に置く（規約上安全・推奨）
# midjourney: 中継 API で完全自動（Midjourney の規約で自動化は禁止。アカウント停止リスクあり）
# gemini: Google の画像生成モデル（公式 API で完全自動。GEMINI_API_KEY が必要）
# mock: 仮画像（動作確認用）
IMAGE_PROVIDER=mock
# MJ_API_BASE_URL=https://api.piapi.ai
# MJ_API_KEY=
# MJ_PARAMS=--v 7 --style raw --s 50 --no text, letters, logo, watermark
# MJ_VIDEO_ENABLED=false
# 手渡しの置き場所: local（data/inbox。Actions では adops-state ブランチの inbox/）か drive（Google ドライブ）
# MJ_INBOX=local
# MJ_INBOX_DIR=data/inbox
# drive の場合: サービスアカウントの鍵 JSON（1行）と、そのアカウントに共有したフォルダの ID
# GOOGLE_SERVICE_ACCOUNT_JSON=
# DRIVE_INBOX_FOLDER_ID=

# Gemini（単独でも、手渡しの代替としても使う）
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview   # 最新の画像モデル名に合わせる
# GEMINI_IMAGE_COUNT=2
# 手渡しで何時間画像が届かなければ Gemini で代わりに作るか（GEMINI_API_KEY がある場合。0 で無効）
# IMAGE_FALLBACK_AFTER_HOURS=24

# ===== Meta（Facebook / Instagram） =====
# システムユーザーの長期トークン（ads_management, ads_read, pages_read_engagement, business_management）
META_ACCESS_TOKEN=
# META_APP_SECRET=                    # 設定すると appsecret_proof を付ける
META_AD_ACCOUNT_ID=                   # act_ なしの数字
META_PAGE_ID=
META_INSTAGRAM_USER_ID=
# META_API_VERSION=v25.0
# 応募としてカウントする action_type（カンマ区切り、先頭から優先）
# META_CONVERSION_ACTION_TYPES=offsite_conversion.fb_pixel_lead,onsite_conversion.lead_grouped
# META_USE_PLACEMENT_CUSTOMIZATION=true

# ===== Google 広告 =====
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=             # adwords + youtube.upload スコープで発行
GOOGLE_ADS_CUSTOMER_ID=               # ハイフンなし
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=       # MCC 経由の場合
# GOOGLE_ADS_API_VERSION=v26
# GOOGLE_ADS_CONVERSION_ACTION=応募完了 # 応募のコンバージョンアクション名（空なら全コンバージョン）
# デマンド ジェネレーション広告に必須
# GOOGLE_ADS_LOGO_ASSET=customers/1234567890/assets/111111
# GOOGLE_ADS_BUSINESS_NAME=
# YOUTUBE_REFRESH_TOKEN=              # 動画用に別アカウントを使う場合

# ===== 選考結果（任意） =====
# 応募管理の結果 CSV（列: utm_content または 企画ID / stage または ステータス / 任意で 応募者ID）。
# Google スプレッドシートの「ウェブに公開 → CSV」URL かローカルパス
# ADOPS_OUTCOMES_CSV_URL=

# ===== 通知 =====
SLACK_WEBHOOK_URL=
# draft モードで、入稿した広告ごとに Slack へ「配信開始 / 却下」ボタンを送る（Next.js アプリの /api/adops/slack が必要）
# ADOPS_SLACK_APPROVALS=true
# ボタンの値の署名鍵（Vercel 側にも同じ値を設定）
# ADOPS_APPROVAL_SECRET=

# ===== 動画のナレーション（任意） =====
# google: Google Cloud Text-to-Speech で各カットの字幕を読み上げる（GOOGLE_SERVICE_ACCOUNT_JSON を使用。API の有効化が必要）
# ADOPS_TTS=google
# ADOPS_TTS_VOICE=ja-JP-Neural2-C
# ADOPS_TTS_RATE=1.1

# ===== その他 =====
# ADOPS_ANALYZE_EVERY_DAYS=1
# ADOPS_MAX_LLM_USD=20                # 1回の実行で Claude に使ってよい上限（USD）
# ADOPS_BGM_PATH=assets/bgm/default.mp3  # 動画の BGM（権利クリア済みのものだけ）
# ADOPS_LOG_LEVEL=info
